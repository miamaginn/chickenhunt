rules_version = '2';

// Open rules for a one-night party game: anyone with the site can read/write
// the hunt. Delete the database (or lock these down) after the party.
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read, write: if true;
      match /teams/{teamId} {
        allow read, write: if true;
        match /visits/{visitId} {
          allow read, write: if true;
        }
      }
    }
  }
}
